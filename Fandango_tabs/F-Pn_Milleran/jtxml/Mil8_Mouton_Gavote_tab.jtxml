                    <track-text descriptor="rich-text" x="57" y="57" alignment="0" visibility="4097" dx="1508" dy="1520" cx="0" cy="0" screen-dx="0" screen-dy="0">{\rtf1\ansi\ansicpg1252\deff0{\fonttbl{\f0\froman\fprq2\fcharset0 Times New Roman;}}{\colortbl ;\red0\green0\blue0;}\viewkind4\uc1\pard\qc\tx560\tx1120\tx1680\tx2240\tx2800\tx3360\tx3920\tx4480\tx5040\tx5600\tx6160\tx6720\cf1\lang1036\b\i\f0\fs52 Charles Mouton\par\b0\fs40 (vers 1626 - vers 1699)\par\pard\qc\i0\fs144\par\cf0 Gavote\par\cf1\fs56 de l'Opera de Vous Savez L'amour Extreme\par\i transpoz\'e9 par \cf0\lang1033 mons.\super r\nosupersub  \cf1\lang1036 Mouton\cf0\i0\fs144\par\cf1\fs40\parCLFMou, N\'b0103 - LWV 32/7\par\par\fs48 Do majeur\par\i\fs36 accord ordinaire\par\i0\fs40\par\pard\qc\tx560\tx1120\tx1680\tx2240\tx2800\tx3360\tx3920\tx4480\tx5040\tx5600\tx6160\tx6720\b\fs48 Manuscrit Milleran F-Pn82\par\b0\i\fs36 Paris, Biblioth\'e8que Nationale\par\i0\fs40 F-Pn ms. R\'e9s. 82\par\pard\qc\i\fs32 Folio 12r. \b\i0\fs52\par}</track-text>
                    <tracker l="216" r="894" t="62" b="714" offet-cx="159" offet-cy="5"/>
